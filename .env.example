# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: "off" or "stripe".
#   off    -> no Stripe needed; "Unlock Pro (free)" grants Pro to the signed-in user.
#   stripe -> Pro is a paid monthly Stripe subscription (needs the STRIPE_* values below).
# If unset: "stripe" when STRIPE_SECRET_KEY is set, otherwise "off".
PAYMENTS_MODE=off

# Stripe (only for PAYMENTS_MODE=stripe): Developers -> API keys (use test mode keys while building)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# The recurring Price for the all-courses Pro subscription
STRIPE_PRO_PRICE_ID=price_...

# Public URL of the site (used for Stripe redirects and auth emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
